# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# PostgreSQL password (required). Any strong value; used by both the DB and the backend.
DB_PASSWORD=

# JWT signing secret (required). Generate with:  openssl rand -base64 48
JWT_SECRET=

# Optional: password for the seeded admin account (admin@localhost.ch by default).
# Leave empty to have a random password generated and printed ONCE to the backend
# log at first start. Either way, the admin must change it at first login.
ADMIN_PASSWORD=

# AES key for secrets the app stores and later replays: issue-tracker API tokens,
# build-server API tokens and OIDC client secrets. Required only if you use those features.
# Generate with:  openssl rand -base64 32
# Without it those features refuse to store a secret rather than keeping it in plaintext.
# Changing it makes existing stored secrets undecryptable; re-enter them in the UI.
APP_ENCRYPTION_KEY=

# Deprecated: an issue-tracker-only key. APP_ENCRYPTION_KEY covers this now; set this only
# if you configured a tracker before the shared key existed and do not want to re-enter it.
ISSUE_TRACKER_ENCRYPTION_KEY=

# Public URL of this instance, injected into pipelines triggered from the UI as TM_BASE_URL
# so a workflow can report results back without hardcoding the address (PRD-024). Optional.
#PUBLIC_BASE_URL=https://testmanagement.example.com

# Optional overrides
#ADMIN_EMAIL=admin@localhost.ch
#CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8012
#ISSUE_TRACKER_ALLOW_PRIVATE_TARGETS=false
# Allow build servers on private/loopback addresses (SSRF guard; enable for a LAN CI server).
#BUILDSERVER_ALLOW_PRIVATE_TARGETS=false
# Where the browser lands after an SSO login. Set this to your public frontend URL when the
# frontend is not served from the same origin as the API.
#SSO_CALLBACK_URL=/login/callback
#SSO_ALLOW_PRIVATE_ISSUERS=false
