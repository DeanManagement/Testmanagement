# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# PostgreSQL password (required). Any strong value; used by both the DB and the backend.
DB_PASSWORD=

# JWT signing secret (required). Generate with:  openssl rand -base64 48
JWT_SECRET=

# Optional: password for the seeded admin account (admin@localhost.ch by default).
# Leave empty to have a random password generated and printed ONCE to the backend
# log at first start. Either way, the admin must change it at first login.
ADMIN_PASSWORD=

# Optional overrides
#ADMIN_EMAIL=admin@localhost.ch
#CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8012
